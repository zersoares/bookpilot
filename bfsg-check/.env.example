# Pfad zu einem Chromium/Chrome-Binary. Leer lassen, wenn Playwright seinen
# eigenen Browser findet (PLAYWRIGHT_BROWSERS_PATH).
CHROMIUM_EXECUTABLE_PATH=

# Nur in Containern nötig, die keine Chromium-Sandbox erlauben (z. B. root ohne
# User-Namespaces). Reduziert die Isolation – nur mit Netzwerk-Egress-Filter nutzen.
BFSG_CHROMIUM_NO_SANDBOX=

# Anzahl Scans pro IP im Zeitfenster (Standard 5 pro 10 Minuten)
BFSG_RATE_LIMIT_MAX=5
BFSG_RATE_LIMIT_WINDOW_SECONDS=600

# Maximale Datenmenge pro Prüfung in MB (Standard 25)
BFSG_MAX_PAGE_MB=25

# Gleichzeitige Scans pro Instanz (Standard 2)
BFSG_MAX_CONCURRENT_SCANS=2

# Nur hinter einem vertrauenswürdigen Reverse-Proxy auf "1" setzen, der
# X-Forwarded-For selbst setzt/überschreibt.
BFSG_TRUST_PROXY=

# NUR Entwicklung/Tests: erlaubt private Ziele (z. B. localhost) im Scanner.
# Wird in Produktion ignoriert.
BFSG_ALLOW_PRIVATE_TARGETS=
